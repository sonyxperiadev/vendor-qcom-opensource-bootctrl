cc_fuzz {
    name: "aidl_fuzzer_bootctrl",
    proprietary: true,

    srcs: ["fuzzer.cpp"],

    shared_libs: [
        "liblog",
        "libbase",
        "libutils",
        "libcutils",
        "libbinder",
        "libbinder_ndk",
        "libboot_control_qti",
        "android.hardware.boot@1.1",
        "android.hardware.boot-V1-ndk",
    ],

    static_libs: [
        "libboot_control",
        "libbinder_random_parcel",
    ],

    include_dirs: [
        "hardware/qcom/bootctrl/aidl",
    ],
}